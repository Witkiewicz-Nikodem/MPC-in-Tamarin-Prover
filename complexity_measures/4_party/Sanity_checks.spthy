lemma Correctness_reachability_2[heuristic={Ex_lemmas}]:
exists-trace
"Ex inA inB inC inD TP #i #k1 #k2 #k3 #k4
    .RCV_data(inA,inB,inC,inD)@i
    &Use_r(cf(inA,inB,inC,inD))@k1 & Use_TP(TP)@k1
    &Use_r(cf(inA,inB,inC,inD))@k2 & Use_TP(TP)@k2
    &Use_r(cf(inA,inB,inC,inD))@k3 & Use_TP(TP)@k3
    &Use_r(cf(inA,inB,inC,inD))@k4 & Use_TP(TP)@k4"

