theory MPC
begin

builtins: multiset, symmetric-encryption, natural-numbers
functions: honest/0, mal/0, f/4, cf/4, dependent/1



///////////////////////
// Channel rules     //
///////////////////////

rule Party:
    []
  --[]->
    [!Party($P)]

rule Corruption:
    [!Party(P)]
  --[P_Corrupted(P)]->
    [!Corrupted(P)]

rule Snd_sec:
    [SndS(sender, receiver, msg)]
  --[]->
    [Sec(sender, receiver, msg)]

rule Rcv_sec:
    [Sec(sender, receiver, msg)]
  --[]->
    [RcvS(sender, receiver, msg)]

rule Inject:
    [In(<sender, receiver, m>), !Corrupted(sender)]
  --[Inject(sender, receiver, m)]->
    [SndS(sender, receiver, m)]

rule Eavesdrop: 
    [Sec(sender, receiver, msg), !Corrupted(receiver)]
  --[Eavesdrop(), Eeav_parties(sender,receiver)]->
    [RcvS(sender, receiver, msg), Out(<sender, receiver, msg>)]

rule MPC_establish_group:
let
    G = <A,B,C,D>
in
    [!Party(A), !Party(B), !Party(C), !Party(D)]
  --[Groupp(G), Group_parties(A,B,C,D)
    ,_restrict(not (A = B | A = C | A = D
                   |B = C | B = D
                   |C = D))]->
    [!Group(G), Out(<G,$TT>)]

rule Honest_MPC_input:
let
    h_in = <~input, honest>
in
    [Fr(~input), !Group(G), !Party(P)]
  --[_restrict(P << G), Inx(P,G,~input), H_in(~input)]->
    [SndS(P, G, h_in)]

rule T_Init:
    [!Group(G), Fr(~TP)]
  --[T_init_G(G), T_init()]->
    [T_RCV(~TP, G), !TP(~TP, G), Out(~TP)]

rule RCV: 
let
    AA = <A,dataA,hmA>
    BB = <B,dataB,hmB>
    CC = <C,dataC,hmC>
    DD = <D,dataD,hmD>
in
    [T_RCV(TP, G)
    ,RcvS(A, TT, <dataA,hmA>)
    ,RcvS(B, TT, <dataB,hmB>)
    ,RcvS(C, TT, <dataC,hmC>)
    ,RcvS(D, TT, <dataD,hmD>)]
  --[_restrict(<A,B,C,D> = G)
    ,_restrict(
          (hmA = honest | hmA = mal)
        & (hmB = honest | hmB = mal)
        & (hmC = honest | hmC = mal)
        & (hmD = honest | hmD = mal)
        )
    , RCV()
    ,RCV_data(dataA,dataB,dataC,dataD)]->
    [Eval_i(AA, BB, CC, DD)]

rule Eval_sec:
let
    r = f(dataA, dataB, dataC, dataD)
in
    [Eval_i(<A, dataA, hmA>, <B, dataB, hmB>, <C, dataC, hmC>, <D,dataD,hmD>)]
    --[_restrict(not (mal + mal << hmA ++ hmB ++ hmC)), EV_h(), HM(hmA, hmB, hmC, hmD)]->
    [Eval(A,dataA,B,dataB,C,dataC,D,dataD)]

rule Eval_m:
    [Eval_i( <A, dataA, hmA>, <B, dataB, hmB>, <C, dataC, hmC>,<D,dataD,hmD>)]
    --[_restrict(mal+mal << hmA + hmB + hmC), EV_m(), HM(hmA, hmB, hmC, hmD)]->
    [Eval_m_0(<A, dataA, hmA>, <B, dataB, hmB>, <C, dataC, hmC>, <D, dataD, hmD>)]

////////////////////////////
//       Send Result      //
////////////////////////////

rule Send_result:
    [Eval_Result(A,B,C,D,x,y,z,w), !TP(TP, G)]
  --[Results_sent(), Result_sent(A,B,C,D,x,y,z,w)]->
    [SndS(TP, A, x), SndS(TP, B, y), SndS(TP, C, z), SndS(TP, D, w)]

////////////////////////////
//   F evaluation         //
////////////////////////////
rule Eval_secure:
let
    result = f(dataA,dataB,dataC,dataD)
in
    [Eval(A,dataA,B,dataB,C,dataC,D,dataD)]
  --[]->
    [Eval_Result(A,B,C,D,result,result,result,result)]    


////////////////////////////
// PRIVACY VIOLATION      //
////////////////////////////

rule Privacy_violation_init:
    [Eval_m_0(<A, dataA, hmA>
             ,<B, dataB, hmB>
             ,<C, dataC, hmC>
             ,<D, dataD, hmD>)]
    --[Privacy_Violation()
      ,In_compromised(dataA)
      ,In_compromised(dataB)
      ,In_compromised(dataC) 
      ,In_compromised(dataD)   ]->
    [Out(dataA), Out(dataB), Out(dataC), Out(dataD)]


////////////////////////////
// independence of inputs //
////////////////////////////

rule Independence_of_inputs_1:
let
    result = f(dataA, dependent(dataA), dataC, dataD)
in
    [Eval_m_0(<A, dataA, honest>
             ,<B, dataB, mal>
             ,<C, dataC, mal>
             ,<D, dataD, mal>)]
  --[EV(), EV_m(), Dep_1(), Dep()]->
    [Eval_Result(A,B,C,D,result,result,result,result)]

rule Independence_of_inputs_2:
let
    result = f(dependent(dataB), dataB, dataC, dataD)
in
    [Eval_m_0(<A, dataA, mal>
             ,<B, dataB, honest>
             ,<C, dataC, mal>
             ,<D, dataD, mal>)]
  --[EV(), EV_m(), Dep_2(), Dep()]->
    [Eval_Result(A,B,C,D, result,result,result,result)]

rule Independence_of_inputs_3:
let
    result = f(dependent(dataC), dataB, dataC, dataD)
in
    [Eval_m_0(<A, dataA, mal>
             ,<B, dataB, mal>
             ,<C, dataC, honest>
             ,<D, dataD, mal>)]
  --[EV(), EV_m(), Dep_3(), Dep()]->
    [Eval_Result(A,B,C,D,result,result,result,result)]

rule Independence_of_inputs_4:
let
    result = f(dependent(dataD), dataB, dataC, dataD)
in
    [Eval_m_0(<A, dataA, mal>
             ,<B, dataB, mal>
             ,<C, dataC, mal>
             ,<D, dataD, honest>)]
  --[EV(), EV_m(), Dep_4(), Dep()]->
    [Eval_Result(A,B,C,D,result,result,result,result)]

////////////////////////////
// Correctness            //
////////////////////////////

rule Correctness:
let
    result = cf(dataA, dataB, dataC, dataD)
in
    [Eval_m_0(<A, dataA, hmA>, <B, dataB, hmB>, <C, dataC, hmC>, <D, dataD, hmD>)]
  --[EV(), EV_m(), Correctness()]->
    [Eval_Result(A,B,C,D,result,result,result,result)]

///////////////////////////////
// Output delivery attributes//
///////////////////////////////

rule Eval_m_for_delivery_attributes:
let
    result = f(dataA, dataB, dataC, dataD)
in
    [Eval_m_0(<A, dataA, hmA>, <B, dataB, hmB>, <C, dataC, hmC>, <D, dataD, hmD>)]
  --[EV(), EV_m(), Eval_m_inputs_equals(), ODV()]->
    [Eval_Result_output_step_0(<A, hmA>, <B, hmB>, <C, hmC>, <D,hmD>, result)]

//////////////////////////////////////////////////////
// adversary choose which honest party gets output  //
//////////////////////////////////////////////////////

// 1
rule Adversar_choose_1_mal:
    [Eval_Result_output_step_0(<A, mal>, <B, hmB>, <C, hmC>, <D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_1_mal(), EV(), EV_f(result), O_mal_delivered(A)]->
    [Eval_Result_adv_choose_step_1(<B, hmB>, <C, hmC>, <D,hmD>, result), SndS(TP, A, result)]

rule Adversar_choose_1_honest_send:
    [Eval_Result_output_step_0(<A, honest>, <B, hmB>, <C, hmC>, <D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_1_honest_send(), EV(), EV_f(result), O_honest_delivered(A)]->
    [Eval_Result_adv_choose_step_1(<B, hmB>, <C, hmC>, <D,hmD>, result), SndS(TP, A, result)]

rule Adversar_choose_1_honest_not_send:
    [Eval_Result_output_step_0(<A, honest>, <B, hmB>, <C, hmC>, <D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_1_honest_not_send(), EV(), EV_f(result), O_mal(A), O_viol()]->
    [Eval_Result_adv_choose_step_1(<B, hmB>, <C, hmC>, <D,hmD>, result)]

//2 
// 1
rule Adversar_choose_2_mal:
    [Eval_Result_adv_choose_step_1(<B, hmB>, <C, hmC>, <D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_2_mal(), EV(), EV_f(result), O_mal_delivered(B)]->
    [Eval_Result_adv_choose_step_2(<C, hmC>, <D,hmD>, result), SndS(TP, B, result)]

rule Adversar_choose_2_honest_send:
    [Eval_Result_adv_choose_step_1(<B, hmB>, <C, hmC>, <D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_2_honest_send(), EV(), EV_f(result), O_honest_delivered(B)]->
    [Eval_Result_adv_choose_step_2(<C, hmC>, <D,hmD>, result), SndS(TP, B, result)]

rule Adversar_choose_2_honest_not_send:
    [Eval_Result_adv_choose_step_1(<B, hmB>, <C, hmC>, <D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_2_honest_not_send(), EV(), EV_f(result), O_mal(B), O_viol()]->
    [Eval_Result_adv_choose_step_2(<C, hmC>, <D,hmD>, result)]

// 3
rule Adversar_choose_3_mal:
    [Eval_Result_adv_choose_step_2(<C, hmC>, <D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_3_mal(), EV(), EV_f(result), O_mal_delivered(C)]->
    [Eval_Result_adv_choose_step_3(<D,hmD>, result), SndS(TP, C, result)]

rule Adversar_choose_3_honest_send:
    [Eval_Result_adv_choose_step_2(<C, hmC>, <D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_3_honest_send(), EV(), EV_f(result), O_honest_delivered(C)]->
    [Eval_Result_adv_choose_step_3(<D,hmD>, result), SndS(TP, C, result)]

rule Adversar_choose_3_honest_not_send:
    [Eval_Result_adv_choose_step_2(<C, hmC>, <D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_3_honest_not_send(), EV(), EV_f(result), O_mal(C), O_viol()]->
    [Eval_Result_adv_choose_step_3(<D,hmD>, result)]

// 4
rule Adversar_choose_4_mal:
    [Eval_Result_adv_choose_step_3(<D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_finish_mal(), EV(), EV_f(result), O_mal_delivered(D)]->
    [SndS(TP, D, result)]

rule Adversar_choose_4_honest_send:
    [Eval_Result_adv_choose_step_3(<D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_finish_honest_send(), EV(), EV_f(result), O_honest_delivered(D)]->
    [SndS(TP, D, result)]

rule Adversar_choose_4_honest_not_send:
    [Eval_Result_adv_choose_step_3(<D,hmD>, result), !TP(TP, G)]
  --[Adv_choose_out_finish_honest_not_send(), EV(), EV_f(result), O_mal(D), O_viol()]->
    []


////////////////////////////
// USE rules              /
//////////////////////////

rule Party_receive_result:
[RcvS(TP, P, r)]--[Use_TP(TP), Use_P(P), Use_r(r)]->[]

////////////////////////////
// SOURCES LEMMAS         //
////////////////////////////

lemma sources [sources, heuristic={Sources}]:
"All input #i. In_compromised(input)@i ==>(
    (Ex #j1. KU(input)@j1 & j1 < #i)
    |
    (Ex #j2. H_in(input)@j2 & #j2 < #i)
    )"

///////////////////
/* Restrictions  */
///////////////////


restriction only_once_G1:
"All G1 G2 #i #j. Groupp(G1)@i & Groupp(G2)@j ==> #i=#j"

restriction only_once_MPC:
"All #i #j. T_init()@i & T_init()@j ==> #i = #j"

restriction only_one_corruption_per_party:
"All X1 #i #j. Corruption_Party(X1)@i & Corruption_Party(X1)@j ==> #i = #j"

restriction one_input_per_party:
"All X #i #j. Input_Party(X)@i & Input_Party(X)@j ==> #i = #j"

restriction Once_corrupted_no_honest_input:
"All P G data #i. Inx(P,G,data)@i ==> not Ex #j. P_Corrupted(P)@j"

