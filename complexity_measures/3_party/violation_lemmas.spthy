/* violations */

////////////////
/*  Privacy   */
////////////////

lemma privacy_hold[heuristic={All_lemmas}]:
"All A G inA #i
 .Inx(A,G,inA)@i
 &(not Ex X #k. P_Corrupted(X)@k)    
    ==> not Ex #k1. K(inA)@k1"

lemma privacy_violated_fst_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A B C G inA #i1 #i2 #j
    .Group_parties(A,B,C)@i1
    &Inx(A,G,inA)@i2
    &(not Ex #k. P_Corrupted(A)@k)
    &K(inA)@j"

lemma privacy_violated_snd_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A B C G inB #i1 #i2 #j
    .Group_parties(A,B,C)@i1
    &Inx(B,G,inB)@i2
    &(not Ex #k. P_Corrupted(B)@k)
    &K(inB)@j"

lemma privacy_violated_3rd_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A B C G inC #i1 #i2 #j
    .Group_parties(A,B,C)@i1
    &Inx(C,G,inC)@i2
    &(not Ex #k. P_Corrupted(C)@k)
    &K(inC)@j"


////////////////
/* Correctnes */
////////////////

lemma correctness_hold[heuristic={All_lemmas}]:
"(not Ex X #k. P_Corrupted(X)@k)   
    ==> not Ex inA inB inC #k. Use_r(cf(inA,inB,inC))@k"

lemma correctness_violated_fst_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A B C inA inB inC #i #j
    .Group_parties(A,B,C)@i
    &Use_P(A)@j & Use_r(cf(inA,inB,inC))@j
    & (not Ex #k. P_Corrupted(A)@k)"

lemma correctness_violated_snd_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A B C inA inB inC #i #j
    .Group_parties(A,B,C)@i
    &Use_P(A)@j & Use_r(cf(inA,inB,inC))@j
    & (not Ex #k. P_Corrupted(B)@k)"

lemma correctness_violated_3rd_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A B C inA inB inC #i #j
    .Group_parties(A,B,C)@i
    &Use_P(A)@j & Use_r(cf(inA,inB,inC))@j
    & (not Ex #k. P_Corrupted(C)@k)"

////////////////
/*Independence*/
////////////////

lemma independence_of_inputs_hold[heuristic={All_lemmas}]:
"(not Ex X #k. P_Corrupted(X)@k)  
    ==> not (Ex #i. Dep()@i)"

lemma independence_of_inputs_violated_first_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A G inA inC #i #j
    . Inx(A,G,inA)@i
    & (not Ex #k. P_Corrupted(A)@k)
    & Use_r(f(inA, dependent(inA), inC))@j"

lemma independence_of_inputs_violated_second_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex B G inB inC #i #j
    . Inx(B,G,inB)@i 
    & (not Ex #k. P_Corrupted(B)@k)
    & Use_r(f(dependent(inB), inB, inC))@j"

lemma independence_of_inputs_violated_3rd_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex C G inB inC #i #j
    . Inx(C,G,inC)@i 
    & (not Ex #k. P_Corrupted(C)@k)
    & Use_r(f(dependent(inC), inB, inC))@j"

///////////////////////////////
// Output delivery attributes//
///////////////////////////////


lemma output_delivery_a_party_without_output[heuristic={All_lemmas}]:
"All X #i
    .O_mal(X)@i
    ==> (not Ex #j. Use_A(X)@j)"

lemma Output_delivery_hold[heuristic={All_lemmas}]:
"(not Ex X #k. P_Corrupted(X)@k)   
    ==> not (Ex #i. ODV()@i)"

lemma O_viol_corrupted_party_use_output[heuristic={Ex_lemmas}]:
exists-trace
"Ex P #i #j
    .O_mal_delivered(P)@i & Use_P(P)@j"

lemma O_viol_fst_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A B C #i #j 
    .Group_parties(A,B,C)@i
    &O_viol()@j
    &(not (Ex #k. P_Corrupted(A)@k))"


lemma O_viol_snd_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A B C #i #j 
    .Group_parties(A,B,C)@i
    &O_viol()@j
    &(not (Ex #k. P_Corrupted(B)@k))"

lemma O_viol_3rd_party[heuristic={Ex_lemmas}]:
exists-trace
"Ex A B C #i #j 
    .Group_parties(A,B,C)@i
    &O_viol()@j
    &(not (Ex #k. P_Corrupted(C)@k))"
