/* Sanity checks */

lemma honest_input_received:
exists-trace
"Ex data x #i #j
    .H_in(data)@i
    &T_received(data, x)@j"

lemma honest_input_received_2:
exists-trace
"Ex data x #i #j
    .H_in(data)@i
    &T_received(x, data)@j"


lemma Independence_of_inputs_reachability_1 [heuristic={Ex_lemmas}]:
exists-trace
"Ex #i. EV_1()@i"

lemma Independence_of_inputs_reachability_2 [heuristic={Ex_lemmas}]:
exists-trace
"Ex #i. EV_2()@i"

lemma Correctness_reachability[heuristic={Ex_lemmas}]:
exists-trace
"Ex #i. Correctness()@i"

lemma Correctness_reachability_1[heuristic={Ex_lemmas}]:
exists-trace
"Ex TP #i #k1 #k2
    .T_init_TP(TP)@i
    &Use_r(true)@k1 & Use_TP(TP)@k1
    &Use_r(false)@k2 & Use_TP(TP)@k2
    & not #k1 = #k2"

lemma Correctness_reachability_2[heuristic={Ex_lemmas}]:
exists-trace
"Ex TP #i #k1 #k2
    .T_init_TP(TP)@i
    &Use_r(false)@k1 & Use_TP(TP)@k1
    &Use_r(true)@k2 & Use_TP(TP)@k2
    & not #k1 = #k2"

lemma Correctness_reachability_3[heuristic={Ex_lemmas}]:
exists-trace
"Ex TP #i #k1 #k2
    .T_init_TP(TP)@i
    &Use_r(true)@k1 & Use_TP(TP)@k1
    &Use_r(true)@k2 & Use_TP(TP)@k2
    & not #k1 = #k2"


lemma EX_fairness_secure_eval_no_output:
exists-trace
"Ex #i. Fairness_no_output()@i"

lemma ALL_fairness_secure_eval_no_output:
"All P #i .Fairness_no_output()@i
    ==> not Ex #j Use_P(P)@j"

lemma Adversary_choose_2_mal_reachability[heuristic={Ex_lemmas}]:
exists-trace
"Ex #i. Adv_choose_out_finish_mal()@i"

lemma Adversary_choose_2_honest_send_reachability[heuristic={Ex_lemmas}]:
