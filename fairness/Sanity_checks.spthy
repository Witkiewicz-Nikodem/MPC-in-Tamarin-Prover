lemma Adversary_choose_1_mal_reachability[heuristic={Ex_lemmas}]:
exists-trace
"Ex #i. Adv_choose_out_1_mal()@i"

lemma Adversary_choose_1_honest_send_reachability[heuristic={Ex_lemmas}]:
exists-trace
"Ex #i. Adv_choose_out_1_honest_send()@i"

lemma Adversary_choose_1_honest_not_send_reachability[heuristic={Ex_lemmas}]:
exists-trace
